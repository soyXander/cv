---
import Section from "@/components/Section.astro"

import { projects } from "@cv"
---

<Section title="Proyectos destacados">
  <div class="projects-grid grid grid-cols-1 gap-3 sm:grid-cols-2">
    {
      projects.map(({ name, description, highlights, url }) => {
        return (
          <article class="project-entry rounded border border-muted p-2 transition hover:border-secondary print:border-secondary">
            <h3 class="font-semibold">
              <a
                class="cursor-pointer hover:underline"
                href={url ? url : null}
                target="_blank"
                rel="noopener noreferrer">
                {name}
              </a>
              <a class="hidden text-xs print:block print:break-all">{url}</a>
            </h3>
            <p class="mt-1 font-mono text-xs text-secondary">{description}</p>
            <footer class="mt-2 flex flex-wrap gap-1 gap-x-1">
              {highlights.map((highlight) => (
                <div class="flex cursor-default flex-row items-center rounded-md border border-transparent bg-primary p-1.5 font-mono text-xs font-thin text-white transition-colors hover:bg-secondary print:border-secondary print:text-secondary">
                  <span>{highlight}</span>
                </div>
              ))}
            </footer>
          </article>
        )
      })
    }
  </div>
</Section>
