---
import Section from "@/components/Section.astro"
import { formatDate } from "@/utils/formatDate"

import { education } from "@cv"
---

<div class="hidden print:mt-2 print:block">&nbsp;</div>
<Section title="Educación">
  {
    education.map(({ institution, career, studyType, startDate, endDate }) => {
      return (
        <div class="space-y-1 pb-4">
          <div class="flex justify-between">
            <h3>
              <a class="text-base font-bold">{career}</a>
              {studyType && (
                <span class="inline-flex gap-x-1">
                  <div class="pointer-events-none rounded-md border border-transparent bg-muted px-1.5 py-0.5 font-mono text-xs font-semibold print:border-secondary">
                    {studyType}
                  </div>
                </span>
              )}
            </h3>
            <h3 class="text-sm tabular-nums text-gray-500">
              {formatDate(startDate)} - {formatDate(endDate)}
            </h3>
          </div>
          <h4 class="text-pretty font-mono text-sm text-primary">
            {institution}
          </h4>
        </div>
      )
    })
  }
</Section>
