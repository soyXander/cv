---
import Section from "@/components/Section.astro"
import { formatDate } from "@/utils/formatDate"

import { work } from "@cv"
---

<Section title="Experiencia">
  {
    work.map(({ name, position, url, badge, startDate, endDate, summary, highlights = [] }) => {
      return (
        <div class="experience-entry pb-4">
          <div class="flex flex-wrap justify-between gap-x-4 gap-y-1">
            <div class="flex flex-wrap items-center gap-x-1 gap-y-1">
              <a
                href={url ? url : null}
                target="_blank"
                rel="noopener noreferrer"
                class="cursor-pointer text-base font-bold hover:underline">
                {name}
              </a>
              {position && (
                <span class="inline-flex gap-x-1">
                  <div class="pointer-events-none rounded-md border border-transparent bg-muted px-1.5 py-0.5 font-mono text-xs font-semibold print:border-secondary">
                    {position}
                  </div>
                </span>
              )}
            </div>
            <h3 class="text-sm tabular-nums text-gray-500">
              {formatDate(startDate)} - {formatDate(endDate)}
            </h3>
          </div>
          <p class="text-pretty font-mono text-xs text-secondary">{summary}</p>
          {highlights.length > 0 && (
            <ul class="mt-1 list-disc space-y-1 pl-4 font-mono text-xs text-secondary">
              {highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
          )}
        </div>
      )
    })
  }
</Section>
