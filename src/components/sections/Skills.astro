---
import type { Icon } from "@/types"
import { skills } from "@cv"

import Section from "@/components/Section.astro"
// import AWSIcon from "@/icons/AWS.astro"
import AngularIcon from "@/icons/Angular.astro"
import CSS3Icon from "@/icons/CSS3.astro"
// import CloudflareIcon from "@/icons/Cloudflare.astro"
import ExpressIcon from "@/icons/Express.astro"
import FirebaseIcon from "@/icons/Firebase.astro"
import GitIcon from "@/icons/Git.astro"
import GitHubIcon from "@/icons/GitHub.astro"
import HTML5Icon from "@/icons/HTML5.astro"
import JavaIcon from "@/icons/Java.astro"
import JavaScriptIcon from "@/icons/JavaScript.astro"
import MongoDBIcon from "@/icons/MongoDB.astro"
import MySQLIcon from "@/icons/MySQL.astro"
import NodeJSIcon from "@/icons/NodeJS.astro"
import PostgreSQLIcon from "@/icons/PostgreSQL.astro"
import PyQtIcon from "@/icons/PyQt.astro"
import PythonIcon from "@/icons/Python.astro"
import ReactIcon from "@/icons/React.astro"
import SpringIcon from "@/icons/Spring.astro"
import TailwindCSSIcon from "@/icons/TailwindCSS.astro"
import TypeScriptIcon from "@/icons/TypeScript.astro"
// import VercelIcon from "@/icons/Vercel.astro"
import AstroIcon from "@/icons/Astro.astro"
import WooCommerceIcon from "@/icons/WooCommerce.astro"
import WordPressIcon from "@/icons/WordPress.astro"

const ICONS: Icon = {
  AngularIcon,
  AstroIcon,
  // AWSIcon,
  // CloudflareIcon,
  CSS3Icon,
  ExpressIcon,
  FirebaseIcon,
  GitIcon,
  GitHubIcon,
  HTML5Icon,
  JavaIcon,
  JavaScriptIcon,
  MongoDBIcon,
  MySQLIcon,
  NodeJSIcon,
  PostgreSQLIcon,
  PyQtIcon,
  PythonIcon,
  ReactIcon,
  SpringIcon,
  TailwindCSSIcon,
  TypeScriptIcon,
  // VercelIcon,
  WooCommerceIcon,
  WordPressIcon,
}

const getLevelName = (level: number) => {
  switch (level) {
    case 1:
      return "(Familiarizado)"
    case 2:
      return "(Intermedio)"
    case 3:
      return "(Experto)"
    default:
      return "No especificado"
  }
}
---

<!-- <div class="hidden print:mt-16 print:block">&nbsp;</div> -->
<Section title="Habilidades">
  <!-- Bento Grid -->
  <div class="mt-4 grid grid-cols-2 gap-4">
    <div
      class="relative col-span-2 flex flex-wrap justify-center gap-2 rounded-lg border border-muted p-2 transition-colors hover:border-secondary print:border-secondary">
      <h2
        class="absolute -top-3 left-4 bg-white px-1 text-xs font-semibold text-primary">
        FrontEnd
      </h2>
      {
        skills.frontend.map(({ name, level }) => {
          const Icon = ICONS[name + "Icon"]

          return (
            <span class="inline-flex gap-x-1">
              <div class="flex cursor-default flex-col items-center justify-center gap-x-1 rounded-md border border-transparent bg-primary p-1.5 font-mono text-xs font-semibold text-white transition-colors hover:bg-secondary print:border-secondary print:text-secondary">
                <div class="flex items-center gap-x-1">
                  {Icon && <Icon />}
                  <span>{name}</span>
                </div>
                <p class="text-xs">{getLevelName(level)}</p>
              </div>
            </span>
          )
        })
      }
    </div>
    <div
      class="relative col-span-1 flex flex-wrap justify-center gap-2 rounded-lg border border-muted p-2 transition-colors hover:border-secondary print:border-secondary">
      <h2
        class="absolute -top-3 left-4 bg-white px-1 text-xs font-semibold text-primary">
        BackEnd
      </h2>
      {
        skills.backend.map(({ name, level }) => {
          const Icon = ICONS[name + "Icon"]

          return (
            <span class="inline-flex gap-x-1">
              <div class="flex cursor-default flex-col items-center justify-center gap-x-1 rounded-md border border-transparent bg-primary p-1.5 font-mono text-xs font-semibold text-white transition-colors hover:bg-secondary print:border-secondary print:text-secondary">
                <div class="flex items-center gap-x-1">
                  {Icon && <Icon />}
                  <span>{name}</span>
                </div>
                <p class="text-xs">{getLevelName(level)}</p>
              </div>
            </span>
          )
        })
      }
    </div>
    <div
      class="relative col-span-1 flex flex-wrap justify-center gap-2 rounded-lg border border-muted p-2 transition-colors hover:border-secondary print:border-secondary">
      <h2
        class="absolute -top-3 left-4 bg-white px-1 text-xs font-semibold text-primary">
        Otros
      </h2>
      {
        skills.other.map(({ name, level }) => {
          const Icon = ICONS[name + "Icon"]

          return (
            <div class="flex cursor-default flex-col items-center justify-center gap-x-1 rounded-md border border-transparent bg-primary p-1.5 font-mono text-xs font-semibold text-white transition-colors hover:bg-secondary print:border-secondary print:text-secondary">
              <div class="flex items-center gap-x-1">
                {Icon && <Icon />}
                <span>{name}</span>
              </div>
              <p class="text-xs">{getLevelName(level)}</p>
            </div>
          )
        })
      }
    </div>
  </div>
</Section>
