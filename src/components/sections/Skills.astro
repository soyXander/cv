---
import Section from "@/components/Section.astro"
import { skills, languages } from "@cv"

const groups = [
  { title: "Automatización e IA", items: skills.automation },
  { title: "Desarrollo e integraciones", items: skills.backend },
  { title: "Web", items: skills.frontend },
  { title: "Datos y mantenimiento", items: skills.other },
]

const getLevelName = (level: number) => {
  if (level === 3) return "Avanzado"
  if (level === 2) return "Intermedio"
  if (level === 1) return "Familiarizado"
  return ""
}
---

<Section title="Habilidades">
  <dl class="space-y-2 font-mono text-xs text-secondary">
    {
      groups.map(({ title, items }) => (
        <div class="skills-group">
          <dt class="font-semibold text-primary">{title}</dt>
          <dd>
            {items.map(({ name, level }) => {
              const levelName = getLevelName(level)
              return levelName ? `${name} (${levelName})` : name
            }).join(" · ")}
          </dd>
        </div>
      ))
    }
    <div class="skills-group">
      <dt class="font-semibold text-primary">Idiomas</dt>
      <dd>{languages.map(({ language, fluency }) => `${language}: ${fluency}`).join(" · ")}</dd>
    </div>
  </dl>
</Section>
