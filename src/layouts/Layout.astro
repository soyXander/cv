---
import "@/styles/global.css"

interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Currículum de Gabriel Humerez Romero: desarrollo Full Stack, automatización e integración de agentes de IA."
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body
    class="container relative mx-auto scroll-my-12 overflow-auto p-4 md:p-16 print:p-0">
    <slot />
  </body>
</html>

<style is:global>
  html {
    font-family: "Inter Variable", system-ui, sans-serif;
    background-size: 224px;
  }
  p {
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      Liberation Mono,
      Courier New,
      monospace;
  }
  @page {
    size: A4;
    margin: 13mm;
  }

  @media print {
    html, body {
      font-size: 14px;
      color: #111;
    }
    body {
      width: auto;
      max-width: none;
      margin: 0;
      padding: 0;
      overflow: visible;
    }
    main {
      max-width: none !important;
    }
    main > * + * {
      margin-top: 1rem !important;
    }
    p, li, dd {
      font-size: 10pt;
      line-height: 1.35;
    }
    main .font-mono, p {
      font-family: Arial, sans-serif;
    }
    main .text-xs {
      font-size: 10pt;
    }
    .text-secondary {
      color: #333;
    }
    .project-entry footer > div {
      transition: none;
      background: transparent;
      color: #111;
      border-color: #9ca3af;
    }
    .experience-entry, .project-entry, .education-entry, .skills-group {
      break-inside: avoid;
    }
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    h2, h3 {
      break-after: avoid;
    }
  }
</style>
